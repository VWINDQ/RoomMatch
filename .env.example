ROOMMATCH_PORT=3001
# Generate a password (hex is URL-safe), then use the same value in both URLs.
PGUSER=roommatch
PGDATABASE=roommatch
PGPORT=5432
PGPASSWORD=replace-with-a-random-hex-password
DATABASE_URL=postgresql://roommatch:replace-with-a-random-hex-password@127.0.0.1:5432/roommatch
TEST_DATABASE_URL=postgresql://roommatch:replace-with-a-random-hex-password@127.0.0.1:5432/roommatch_test
# Development demo data defaults to enabled. Set false for an empty database/import.
ROOMMATCH_SEED=true
ROOMMATCH_UPLOAD_DIR=./storage/uploads
ROOMMATCH_TOKEN_SECRET=replace-with-a-long-random-secret

# Optional Google sign-in: set all three values to enable it (no VITE_ prefix).
# Local Vite example: http://localhost:5173; production must use HTTPS.
ROOMMATCH_PUBLIC_ORIGIN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Register this exact redirect URI in Google Cloud:
# http://localhost:5173/api/auth/oauth/google/callback
